<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="autonomous_sphere_collector">

    <xacro:property name="base_length" value="0.6"/>
    <xacro:property name="base_width"  value="0.4"/>
    <xacro:property name="base_height" value="0.2"/>
    <xacro:property name="base_mass"   value="10.0"/>

   
    <xacro:define_materials/>

    <!-- Lidar -->
    <xacro:sensor_link name="lidar" geometry="cylinder" radius="0.1" length="0.05" size_x="0" size_y="0" size_z="0" mass="0.2" material="white"/>

    <!-- Camera -->
    <xacro:sensor_link name="camera_link" geometry="box" size_x="0.02" size_y="0.07" size_z="0.02" radius="0" length="0" mass="0.1" material="white"/>

    <!-- IMU -->
    <xacro:sensor_link name="imu_link" geometry="box" size_x="0.025" size_y="0.08" size_z="0.01" radius="0" length="0" mass="0.05" material="grey"/>

    <!-- Left wheel -->
    <xacro:wheel_link name="left_wheel" radius="0.1" length="0.05" mass="1.0" material="white" rpy="1.57 0 0"/>

    <!-- Right wheel -->
    <xacro:wheel_link name="right_wheel" radius="0.1" length="0.05" mass="1.0" material="white" rpy="1.57 0 0"/>

    <!-- Caster wheel -->
    <xacro:caster_link name="caster_wheel" radius="0.05" mass="0.5" material="white"/>

    <!--WINGS-->
    <xacro:wing_link name="scoop_left_wing"  size_x="0.1" size_y="0.040" size_z="0.05" mass="0.5" material="white"/>
    <xacro:wing_link name="scoop_right_wing" size_x="0.1" size_y="0.040" size_z="0.05" mass="0.5" material="white"/>

    <!--BUCKET WALLS-->
    <xacro:bucket_wall name="bucket_bottom" size_x="0.1" size_y="0.3" size_z="0.01" mass="0.3" ixx="0.000075" iyy="0.00075" izz="0.00075" material="white"/>

    <xacro:bucket_wall name="bucket_back_wall" size_x="0.01" size_y="0.3" size_z="0.15" mass="0.5" ixx="0.0010" iyy="0.0031" izz="0.0031" material="white"/>

    <xacro:bucket_wall name="bucket_left_wall" size_x="0.1" size_y="0.006" size_z="0.15" mass="0.2" ixx="0.00038" iyy="0.00013" izz="0.00042" material="white"/>

    <xacro:bucket_wall name="bucket_right_wall" size_x="0.1" size_y="0.006" size_z="0.15" mass="0.2" ixx="0.00038" iyy="0.00013" izz="0.00042" material="white"/>

    <xacro:bucket_wall name="bucket_front_lip" size_x="0.02" size_y="0.3" size_z="0.005" mass="0.1" ixx="0.000019" iyy="0.00045" izz="0.00045" material="white"/>

    <!--BUCKET JOINTS-->
    <xacro:bucket_joint name="bucket_bottom_joint" parent="bucket" child="bucket_bottom" xyz="0.38 0 0.01" rpy="0 0 0"/>

    <xacro:bucket_joint name="bucket_back_wall_joint" parent="bucket" child="bucket_back_wall" xyz="0.325 0 0.08" rpy="0 0 0"/>

    <xacro:bucket_joint name="bucket_left_wall_joint" parent="bucket" child="bucket_left_wall" xyz="0.38 0.15 0.08" rpy="0 0 0"/>

    <xacro:bucket_joint name="bucket_right_wall_joint" parent="bucket" child="bucket_right_wall" xyz="0.38 -0.15 0.08" rpy="0 0 0"/>

    <xacro:bucket_joint name="bucket_front_lip_joint" parent="bucket_bottom" child="bucket_front_lip" xyz="0.059 0.0 0" rpy="0 0.28 0"/>

    <!-- Base joints -->
<xacro:generic_joint name="footprint_base_joint" type="fixed" parent="base_footprint" child="base_link" xyz="0 0 0.12" rpy="0 0 0" axis="" lower="" upper="" effort="" velocity=""/>

<xacro:generic_joint name="base_lidar_joint" type="fixed" parent="base_link" child="lidar" xyz="0 0 0.225" rpy="0 0 0" axis="" lower="" upper="" effort="" velocity=""/>

<!-- Wheel joints -->
<xacro:generic_joint name="base_left_wheel" type="continuous" parent="base_link" child="left_wheel" xyz="-0.15 0.225 -0.02" rpy="0 0 0" axis="0 1 0" lower="" upper="" effort="" velocity=""/>

<xacro:generic_joint name="base_right_wheel" type="continuous" parent="base_link" child="right_wheel" xyz="-0.15 -0.225 -0.02" rpy="0 0 0" axis="0 1 0" lower="" upper="" effort="" velocity=""/>

<xacro:generic_joint name="base_caster_wheel" type="fixed" parent="base_link" child="caster_wheel" xyz="0.2 0 -0.07" rpy="0 0 0" axis="" lower="" upper="" effort="" velocity=""/>

<!-- Scoop joints -->
<xacro:generic_joint name="bucket_revolute_joint" type="fixed" parent="scoop_left_wing" child="bucket" xyz="-0.3 -0.18 -0.015" rpy="0 0 0.0" axis="" lower="" upper="" effort="" velocity=""/>

<xacro:generic_joint name="scoop_right_wing_joint" type="revolute" parent="base_link" child="scoop_right_wing" xyz="0.30 -0.18 0.05" rpy="0 0 0" axis="0 1 0" lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>

<xacro:generic_joint name="scoop_left_wing_joint" type="revolute" parent="base_link" child="scoop_left_wing" xyz="0.30 0.18 0.05" rpy="0 0 0" axis="0 1 0" lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>

<!-- Camera & IMU joints -->
<xacro:generic_joint name="camera_joint" type="fixed" parent="base_link" child="camera_link" xyz="0.30 0.0 0.215" rpy="0 0.20 0" axis="" lower="" upper="" effort="" velocity=""/>

<xacro:generic_joint name="imu_joint" type="fixed" parent="base_link" child="imu_link" xyz="0.12 0.0 0.201" rpy="0 0 0" axis="" lower="" upper="" effort="" velocity=""/>


    <!--MATERIALS-->
    <xacro:macro name="define_materials">
        <material name="grey">
            <color rgba="0.7 0.7 0.7 1"/>
        </material>

        <material name="green">
            <color rgba="0 0.6 0 1"/>
        </material>
 
        <material name="white">
            <color rgba="1 1 1 1"/>
        </material>
    </xacro:macro>

    <!--GAZEBO LIDAR PLUGIN-->
    <xacro:gazebo_sensor type="lidar" name="lidar_sensor" reference="lidar" update_rate="30">
            <lidar>
                <horizontal>
                    <samples>720</samples>
                    <resolution>1</resolution>
                    <min_angle>-3.14</min_angle>
                    <max_angle>3.14</max_angle>
                </horizontal>
                <range>
                    <min>0.1</min>
                    <max>30.0</max>
                    <resolution>0.01</resolution>
                </range>
            </lidar>
    </xacro:gazebo_sensor>

    <!--CAMERA PLUGIN-->
    <xacro:gazebo_sensor type="camera" name="camera_sensor" reference="camera_link" update_rate="30">
            <camera>
                <horizontal_fov>1.57</horizontal_fov> <!-- ~90 degrees -->
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>50.0</far>
                </clip>
            </camera>
    </xacro:gazebo_sensor>

    <!--IMU PLUGIN-->
    <xacro:gazebo_sensor type="imu" name="imu_sensor" reference="imu_link" update_rate="100">
            <imu>
                <angular_velocity/>
                <linear_acceleration/>
            </imu>
    </xacro:gazebo_sensor>

    <!-- DUMMY LINK AS A FRAME -->
    <link name="base_footprint"/>
    <link name="bucket"/>


    <!-- BASE LINK-->
    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
            <material name="green"/>
        </visual>
        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <origin xyz="0 0 0.1" rpy="0 0 0"/>
        </collision>
        <inertial>
            <mass value="${base_mass}"/>
            <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
            <inertia ixx="0.183" iyy="0.333" izz="0.500" ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>
    </link> 

    <!--SENSOR LINK-->
    <xacro:macro name="sensor_link" params="name geometry size_x size_y size_z radius length mass material">
        <link name="${name}">
            <visual>
                <geometry>
                    <xacro:if value="${geometry == 'box'}">
                        <box size="${size_x} ${size_y} ${size_z}"/>
                    </xacro:if>
                    <xacro:if value="${geometry == 'cylinder'}">
                        <cylinder radius="${radius}" length="${length}"/>
                    </xacro:if>
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <material name="${material}"/>
            </visual>
            <collision>
                <geometry>
                    <xacro:if value="${geometry == 'box'}">
                        <box size="${size_x} ${size_y} ${size_z}"/>
                    </xacro:if>
                    <xacro:if value="${geometry == 'cylinder'}">
                        <cylinder radius="${radius}" length="${length}"/>
                    </xacro:if>
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </collision>
            <inertial>
                <mass value="${mass}"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0.0" ixz="0.0" iyz="0.0"/>
            </inertial>
        </link>
    </xacro:macro>

    <!-- WHEELS LINK-->
    <xacro:macro name="wheel_link" params="name radius length mass material rpy">
        <link name="${name}">
            <visual>
                <geometry>
                    <cylinder radius="${radius}" length="${length}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="${rpy}"/>
                <material name="${material}"/>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${radius}" length="${length}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="${rpy}"/>
            </collision>
            <inertial>
                <mass value="${mass}"/>
                <origin xyz="0 0 0" rpy="${rpy}"/>
                <inertia ixx="0.00375" iyy="0.00375" izz="0.005"/>
            </inertial>
        </link>
    </xacro:macro>

    <xacro:macro name="caster_link" params="name radius mass material">
        <link name="${name}">
            <visual>
                <geometry>
                    <sphere radius="${radius}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <material name="${material}"/>
            </visual>
            <collision>
                <geometry>
                    <sphere radius="${radius}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </collision>
            <inertial>
                <mass value="${mass}"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <inertia ixx="0.001" iyy="0.001" izz="0.001"/>
            </inertial>
        </link>
    </xacro:macro>

    <!-- WING LINKS-->
    <xacro:macro name="wing_link" params="name size_x size_y size_z mass material">
        <link name="${name}">
            <visual>
                <geometry>
                    <box size="${size_x} ${size_y} ${size_z}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <material name="${material}"/>
            </visual>
            <collision>
                <geometry>
                    <box size="${size_x} ${size_y} ${size_z}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </collision>
            <inertial>
                <mass value="${mass}"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <inertia ixx="0.00104" iyy="0.00229" izz="0.00271" ixy="0.0" ixz="0.0" iyz="0.0"/>
            </inertial>
        </link>
    </xacro:macro>

    <!-- Bucket walls & lip-->
    <xacro:macro name="bucket_wall" params="name size_x size_y size_z mass ixx iyy izz material">
        <link name="${name}">
            <visual>
                <geometry>
                    <box size="${size_x} ${size_y} ${size_z}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <material name="${material}"/>
            </visual>
            <collision>
                <geometry>
                    <box size="${size_x} ${size_y} ${size_z}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </collision>
            <inertial>
                <mass value="${mass}"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <inertia ixx="${ixx}" iyy="${iyy}" izz="${izz}" ixy="0.0" ixz="0.0" iyz="0.0"/>
            </inertial>
        </link>
    </xacro:macro>

    <!-- Bucket joints-->
    <xacro:macro name="bucket_joint" params="name parent child xyz rpy">
        <joint name="${name}" type="fixed">
            <parent link="${parent}"/>
            <child link="${child}"/>
            <origin xyz="${xyz}" rpy="${rpy}"/>
        </joint>
    </xacro:macro>

    <xacro:macro name="generic_joint" params="name type parent child xyz rpy axis lower upper effort velocity">
        <joint name="${name}" type="${type}">
            <parent link="${parent}"/>
            <child link="${child}"/>
            <origin xyz="${xyz}" rpy="${rpy}"/>
            <xacro:if value="${axis != ''}">
                <axis xyz="${axis}"/>
            </xacro:if>
            <xacro:if value="${lower != ''}">
                <limit lower="${lower}" upper="${upper}" effort="${effort}" velocity="${velocity}"/>
            </xacro:if>
        </joint>
    </xacro:macro>


</robot>
