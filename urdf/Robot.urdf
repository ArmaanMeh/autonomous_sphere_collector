<?xml version="1.0"?>
<robot name="autonomous_sphere_collector">

    <material name="grey">
        <color rgba="0.7 0.7 0.7 1"/>
    </material>

    <material name="green">
        <color rgba="0 0.6 0 1"/>
    </material>

    <material name="white">
        <color rgba="1 1 1 1"/>
    </material>

    <!-- Virtual footprint link -->
    <link name="base_footprint"/>

    <!-- BASE LINK-->
    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.6 0.4 0.2"/>
            </geometry>
            <origin xyz="0 0 0.1" rpy="0 0 0"/>
            <material name="green"/>
        </visual>
    </link> 

    <!-- LIDAR LINK-->
    <link name="lidar">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.05"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="white"/>
        </visual>
    </link>

    <!-- WHEELS LINK-->
    <link name="left_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.05"/>
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
            <material name="white"/>
        </visual>
    </link>

    <link name="right_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.05"/>
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
            <material name="white"/>
        </visual>
    </link>
    
    <link name="caster_wheel">
        <visual>
            <geometry>
                <sphere radius="0.05"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="white"/>
        </visual>
    </link>

    <!-- SCOOP OR GRIPPING LINK-->
    <!-- Center blade -->
    <link name="scoop_center">
        <visual>
            <geometry>
                <box size="0.40 0.04 0.14"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </geometry>
            <material name="white"/>
        </visual>
    </link>

    <!-- Left wing -->  
    <link name="scoop_left_wing">
        <visual>
            <geometry>
                <box size="0.25 0.04 0.14"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </geometry>
                <material name="white"/>
        </visual>
    </link>

    <!-- Right wing -->
    <link name="scoop_right_wing">
        <visual>
            <geometry>
                <box size="0.25 0.04 0.14"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </geometry>
            <material name="white"/>
        </visual>
    </link>


    <!-- BASE JOINTS-->
    <joint name="footprint_base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.1" rpy="0 0 0"/>
    </joint>

    <joint name="base_lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="lidar"/>
        <origin xyz="0 0 0.225" rpy="0 0 0"/>
    </joint>

    <!-- WHEEL JOINTS-->
    <joint name="base_left_wheel" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="-0.15 0.225 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="base_right_wheel" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="-0.15 -0.225 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="base_caster_wheel" type="fixed">
        <parent link="base_link"/>
        <child link="caster_wheel"/>
        <origin xyz="0.2 0 -0.05" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>
     
     <!-- SCOOP OR GRIPPING JOINT-->
    <joint name="base_bulldozer_scoop" type="revolute">
        <parent link="base_link"/>
        <child link="bulldozer_scoop"/>
        <origin xyz="0.35 0 0.075" rpy="0.3 0 0"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
        <axis xyz="0 1 0"/>
    </joint>

</robot>
