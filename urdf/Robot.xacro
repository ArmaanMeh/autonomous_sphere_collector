<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="autonomous_sphere_collector">

  <!-- ==================== PROPERTIES ==================== -->
  <xacro:property name="base_length" value="0.6"/>
  <xacro:property name="base_width"  value="0.4"/>
  <xacro:property name="base_height" value="0.2"/>
  <xacro:property name="base_mass"   value="10.0"/>

  <!-- ==================== MATERIALS MACRO ==================== -->
  <xacro:macro name="define_materials">
    <material name="grey"><color rgba="0.7 0.7 0.7 1"/></material>
    <material name="green"><color rgba="0 0.6 0 1"/></material>
    <material name="white"><color rgba="1 1 1 1"/></material>
  </xacro:macro>

  <!-- ==================== LINK MACROS ==================== -->
  <xacro:macro name="sensor_link" params="name geometry size_x size_y size_z radius length mass material">
    <link name="${name}">
      <visual>
        <geometry>
          <xacro:if value="${geometry == 'box'}"><box size="${size_x} ${size_y} ${size_z}"/></xacro:if>
          <xacro:if value="${geometry == 'cylinder'}"><cylinder radius="${radius}" length="${length}"/></xacro:if>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <material name="${material}"/>
      </visual>
      <collision>
        <geometry>
          <xacro:if value="${geometry == 'box'}"><box size="${size_x} ${size_y} ${size_z}"/></xacro:if>
          <xacro:if value="${geometry == 'cylinder'}"><cylinder radius="${radius}" length="${length}"/></xacro:if>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </collision>
      <inertial>
        <mass value="${mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0001" iyy="0.0001" izz="0.0001"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="wheel_link" params="name radius length mass material rpy">
    <link name="${name}">
      <visual><geometry><cylinder radius="${radius}" length="${length}"/></geometry><origin xyz="0 0 0" rpy="${rpy}"/><material name="${material}"/></visual>
      <collision><geometry><cylinder radius="${radius}" length="${length}"/></geometry><origin xyz="0 0 0" rpy="${rpy}"/></collision>
      <inertial><mass value="${mass}"/><origin xyz="0 0 0" rpy="${rpy}"/><inertia ixx="0.00375" iyy="0.00375" izz="0.005"/></inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="caster_link" params="name radius mass material">
    <link name="${name}">
      <visual><geometry><sphere radius="${radius}"/></geometry><origin xyz="0 0 0" rpy="0 0 0"/><material name="${material}"/></visual>
      <collision><geometry><sphere radius="${radius}"/></geometry><origin xyz="0 0 0" rpy="0 0 0"/></collision>
      <inertial><mass value="${mass}"/><origin xyz="0 0 0" rpy="0 0 0"/><inertia ixx="0.001" iyy="0.001" izz="0.001"/></inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="wing_link" params="name size_x size_y size_z mass material">
    <link name="${name}">
      <visual><geometry><box size="${size_x} ${size_y} ${size_z}"/></geometry><origin xyz="0 0 0" rpy="0 0 0"/><material name="${material}"/></visual>
      <collision><geometry><box size="${size_x} ${size_y} ${size_z}"/></geometry><origin xyz="0 0 0" rpy="0 0 0"/></collision>
      <inertial><mass value="${mass}"/><origin xyz="0 0 0" rpy="0 0 0"/><inertia ixx="0.00104" iyy="0.00229" izz="0.00271"/></inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="bucket_wall" params="name size_x size_y size_z mass ixx iyy izz material">
    <link name="${name}">
      <visual><geometry><box size="${size_x} ${size_y} ${size_z}"/></geometry><origin xyz="0 0 0" rpy="0 0 0"/><material name="${material}"/></visual>
      <collision><geometry><box size="${size_x} ${size_y} ${size_z}"/></geometry><origin xyz="0 0 0" rpy="0 0 0"/></collision>
      <inertial><mass value="${mass}"/><origin xyz="0 0 0" rpy="0 0 0"/><inertia ixx="${ixx}" iyy="${iyy}" izz="${izz}"/></inertial>
    </link>
  </xacro:macro>

  <!-- ==================== JOINT MACROS ==================== -->
  <xacro:macro name="bucket_joint" params="name parent child xyz rpy">
    <joint name="${name}" type="fixed">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="generic_joint" params="name type parent child xyz rpy axis:='' lower:='' upper:='' effort:='' velocity:=''">
    <joint name="${name}" type="${type}">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <xacro:if value="${axis != ''}"><axis xyz="${axis}"/></xacro:if>
      <xacro:if value="${lower != ''}"><limit lower="${lower}" upper="${upper}" effort="${effort}" velocity="${velocity}"/></xacro:if>
    </joint>
  </xacro:macro>

  <!-- ==================== PLUGIN MACRO ==================== -->
  <xacro:macro name="gazebo_sensor" params="type name reference update_rate extra">
    <gazebo reference="${reference}">
      <sensor name="${name}" type="${type}">
        <update_rate>${update_rate}</update_rate>
        ${extra}
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- ==================== MATERIALS CALL ==================== -->
  <xacro:define_materials/>

  <!-- ==================== LINKS CALLS ==================== -->
  <link name="base_footprint"/>
  <link name="bucket"/>
  <link name="base_link">
    <visual><geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry><origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/><material name="green"/></visual>
    <collision><geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry><origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/></collision>
    <inertial><mass value="${base_mass}"/><origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/><inertia ixx="0.183" iyy="0.333" izz="0.500"/></inertial>
  </link>

  <!-- Sensors -->
  <xacro:sensor_link name="lidar" geometry="cylinder" radius="0.1" length="0.05" size_x="0" size_y="0" size_z="0" mass="0.2" material="white"/>
  <xacro:sensor_link name="camera_link" geometry="box" size_x="0.02" size_y="0.07" size_z="0.02" radius="0" length="0" mass="0.1" material="white"/>
  <xacro:sensor_link name="imu_link" geometry="box" size_x="0.025" size_y="0.08" size_z="0.01" radius="0" length="0"/>
</robot>