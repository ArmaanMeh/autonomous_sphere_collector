<?xml version="1.0"?>
<robot name="autonomous_sphere_collector" xmlns:xacro="https://ros.org/wiki/xacro">
    
    <xacro:include filename="$(find autonomous_sphere_collector)/urdf/sensors.gazebo"/>
    <xacro:include filename="$(find autonomous_sphere_collector)/urdf/materials.xacro"/>
    <xacro:include filename="$(find autonomous_sphere_collector)/urdf/scoop_mechanism.xacro"/>

    <link name="base_footprint"/>

    <joint name="base_footprint_joint" type="fixed">
        <origin xyz="0 0 0.1" rpy="0 0 0"/>
        <parent link="base_footprint"/>
        <child link="base_link"/>
    </joint>

    <link name="base_link">
        <pose>0 0 0.1 0 0 0</pose>
        <inertial>
            <mass value="15.0"/>
            <origin xyz="0.0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.0625" ixy="0" ixz="0" iyy="0.2125" iyz="0" izz="0.25"/>
        </inertial>
        <collision name="collision">
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.6 0.4 0.15"/>
            </geometry>
        </collision>
        <visual name="base_link_visual">
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.6 0.4 0.15"/>
            </geometry>
            <material name="green"/>
        </visual>
    </link>

    <xacro:macro name="wheel" params="prefix x_reflect y_reflect">
        <joint type="continuous" name="${prefix}_wheel_joint">
            <origin xyz="${x_reflect * 0.2} ${y_reflect * 0.235} -0.01" rpy="0 0 0"/>
            <child link="${prefix}_wheel"/>
            <parent link="base_link"/>
            <axis xyz="0 1 0" rpy="0 0 0"/>
            <limit effort="400" velocity="50"/>
            <dynamics damping="0.0" friction="0.0"/>
        </joint>

        <link name="${prefix}_wheel">
            <inertial>
                <mass value="5.0"/>
                <origin xyz="0 0 0" rpy="0 1.5707 1.5707"/>
                <inertia ixx="0.014" ixy="0" ixz="0" iyy="0.014" iyz="0" izz="0.025"/>
            </inertial>
            <collision>
                <origin xyz="0 0 0" rpy="0 1.5707 1.5707"/>
                <geometry>
                    <cylinder radius="0.1" length="0.05"/>
                </geometry>
            </collision>
            <visual name="${prefix}_wheel_visual">
                <origin xyz="0 0 0" rpy="0 1.5707 1.5707"/>
                <geometry>
                    <cylinder radius="0.1" length="0.05"/>
                </geometry>
                <material name="black"/>
            </visual>
        </link>

        <gazebo reference="${prefix}_wheel">
            <mu1>1.0</mu1>
            <mu2>1.0</mu2>
            <kp>1000000.0</kp>
            <kd>100.0</kd>
            <minDepth>0.0001</minDepth>
            <maxVel>1.0</maxVel>
        </gazebo>
    </xacro:macro>

    <xacro:wheel prefix="front_left"   x_reflect="1"  y_reflect="1" />
    <xacro:wheel prefix="front_right"  x_reflect="1"  y_reflect="-1" />
    <xacro:wheel prefix="rear_left"    x_reflect="-1" y_reflect="1" />
    <xacro:wheel prefix="rear_right"   x_reflect="-1" y_reflect="-1" />

    <gazebo reference="base_link">
        <mu1>0.0</mu1>
        <mu2>0.0</mu2>
    </gazebo>

    <joint name="imu_joint" type="fixed">
        <origin xyz="0 0 0.08" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="imu_link"/>
    </joint>

    <link name="imu_link">
        <inertial>
            <mass value="1e-5"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0.0" izz="1e-6"/>
        </inertial>
        <collision name="collision">
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.05 0.1 0.01"/>
            </geometry>
        </collision>
        <visual name="visual">
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.05 0.1 0.01"/>
            </geometry>
            <material name="white"/>
        </visual>
    </link>

    <joint type="fixed" name="scan_joint">
        <origin xyz="0.0 0 0.13" rpy="0 0 0"/>
        <child link="scan_link"/>
        <parent link="base_link"/>
        <axis xyz="0 1 0" rpy="0 0 0"/>
    </joint>

    <link name="scan_link">
        <inertial>
            <mass value="1e-5"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
        </inertial>
        <collision name="collision">
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.025"/>
            </geometry>
        </collision>
        <visual name="scan_link_visual">
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.025"/>
            </geometry>
        </visual>
    </link>

    <gazebo reference="scan_link">
        <selfCollide>false</selfCollide>
        <mu1 value="0.05"/>
        <mu2 value="0.05"/>
    </gazebo>

    <joint type="fixed" name="camera_joint">
        <origin xyz="0.3 0 0.09" rpy="0 0 0"/>
        <child link="camera_link"/>
        <parent link="base_link"/>
    </joint>

    <link name="camera_link">
        <inertial>
            <mass value="1e-5"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0.0" izz="1e-6"/>
        </inertial>
        <collision name="collision">
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.02 0.02 0.02"/>
            </geometry>
        </collision>
        <visual name="visual">
            <origin xyz="0 0 0" rpy="0 0.261799 0"/>
            <geometry>
                <box size="0.02 0.02 0.02"/>
            </geometry>
            <material name="white"/>
        </visual>
    </link>

</robot>